{"ast":null,"code":"import axios from 'axios';\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  data: () => ({\n    rating: 4,\n    jobs: []\n  }),\n  async created() {\n    try {\n      console.log(this.$route.params.id);\n      const response = await axios.get(`${API_LOCATION}/job/category/${this.$route.params.id}`);\n      this.jobs = response.data.result;\n      console.log(this.jobs);\n    } catch (error) {\n      console.log(error);\n    }\n  },\n  methods: {}\n};","map":{"version":3,"mappings":"AA2CA;AACA;AACA;EACAA;IACAC;IACAC;EACA;EACA;IACA;MACAC;MAEA;MACA;MACAA;IACA;MACAA;IACA;EACA;EACAC,UAEA;AACA","names":["data","rating","jobs","console","methods"],"sourceRoot":"src/components/user","sources":["Category-Job-Card.vue"],"sourcesContent":["<template>\r\n    <v-container>\r\n        <template v-if=\"jobs.length > 0\">\r\n            <v-card class=\"pa-10 align-center mb-8\" v-for=\"job in jobs\" :key=\"job.id\">\r\n                <v-row>\r\n                    <v-col md=\"2\">\r\n                        <v-avatar size=\"56\" tile>\r\n                            <v-img v-if=\"job.user\" :src=\"job.image\" style=\"border-radius: 50%;\"></v-img>\r\n                        </v-avatar>\r\n                    </v-col>\r\n                    <v-col md=\"3\">\r\n                        <div>\r\n                            <h3>{{ job.title }}</h3>\r\n                        </div>\r\n                    </v-col>\r\n                    <v-col md=\"2\">\r\n                        <!-- <p class=\"pa-0 ma-0\"><span style=\"font-weight: 500 ;\">Title:</span>{{ job.level }}</p> -->\r\n                        <p class=\"pa-0 ma-0\"><span style=\"font-weight: 500 ;\">Category:</span>{{ job.category.name }}\r\n                        </p>\r\n                        <p class=\"pa-0 ma-0\"><span style=\"font-weight: 500 ;\">Salary:</span>{{ job.pricing }}</p>\r\n                    </v-col>\r\n                    <v-col md=\"3\" v-if='job.user'>\r\n                        <v-rating :value=\"job.user.rating\" background-color=\"purple lighten-3\" readonly color=\"purple\"\r\n                            small></v-rating>\r\n                    </v-col>\r\n                    <v-col md=\"1\">\r\n                        <v-btn small @click=\"$router.push(`/job-detail/${job.id}`)\">\r\n                            view Detail\r\n                        </v-btn>\r\n                    </v-col>\r\n                </v-row>\r\n\r\n            </v-card>\r\n        </template>\r\n        <template v-else>\r\n            <h3 style=\"text-align: center; margin-top: 50px; text-decoration: double;\"><b>No Jobs Available Now For This\r\n                    Category !!</b> </h3>\r\n        </template>\r\n\r\n    </v-container>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport { API_LOCATION } from \"../../config/index\";\r\nexport default {\r\n    data: () => ({\r\n        rating: 4,\r\n        jobs: []\r\n    }),\r\n    async created() {\r\n        try {\r\n            console.log(this.$route.params.id)\r\n\r\n            const response = await axios.get(`${API_LOCATION}/job/category/${this.$route.params.id}`);\r\n            this.jobs = response.data.result;\r\n            console.log(this.jobs)\r\n        } catch (error) {\r\n            console.log(error)\r\n        }\r\n    },\r\n    methods: {\r\n\r\n    }\r\n}\r\n</script>"]},"metadata":{},"sourceType":"module","externalDependencies":[]}