{"ast":null,"code":"import axios from 'axios';\nimport { API_LOCATION } from '@/config';\nexport default {\n  data() {\n    return {\n      blogs: []\n    };\n  },\n  async created() {\n    try {\n      const response = await axios.get(`${API_LOCATION}/blog`);\n      console.log(response.data);\n      this.blogs = response.data.blog;\n      console.log(this.blogs);\n    } catch (error) {\n      console.log(error);\n    }\n  }\n};","map":{"version":3,"mappings":"AA6CA;AACA;AACA;EACAA;IACA;MACAC;IACA;EACA;EACA;IACA;MAEA;MACAC;MACA;MACAA;IACA;MACAA;IACA;EACA;AACA","names":["data","blogs","console"],"sourceRoot":"src/components/user","sources":["User-Blog.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-row>\r\n      <v-col>\r\n        <v-banner>\r\n          <v-row class=\"text-center\">\r\n            <v-col class=\"text-center\">\r\n              <p class=\"black--text text-h6 mb-0 pb-0\">We write Blogs</p>\r\n              <p class=\"grey--text caption\">\r\n                Here our Inside Story and learning\r\n              </p>\r\n            </v-col>\r\n          </v-row>\r\n        </v-banner>\r\n      </v-col>\r\n    </v-row>\r\n    <v-row class=\"pa-5\">\r\n      <v-col md=\"4\" v-for=\"blog in blogs\" :key=\"blog.id\">\r\n\r\n        <v-card class=\"mx-auto\" max-width=\"400\">\r\n          <v-img class=\"white--text align-end\" height=\"200px\" :src=\"blog.image\">\r\n            <v-card-title>{{ blog.title }}</v-card-title>\r\n          </v-img>\r\n\r\n          <v-card-subtitle class=\"pb-0\"> {{ blog.date }} </v-card-subtitle>\r\n\r\n          <v-card-text class=\"text--primary\">\r\n\r\n\r\n            <div>{{ blog.description }}</div>\r\n          </v-card-text>\r\n\r\n          <v-card-actions>\r\n            <!-- <v-btn color=\"orange\" text> Share </v-btn> -->\r\n\r\n            <v-btn color=\"orange\" text @click=\"$router.push(`/single-blog/${blog.id}`)\"> Explore </v-btn>\r\n          </v-card-actions>\r\n        </v-card>\r\n\r\n      </v-col>\r\n    </v-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport { API_LOCATION } from '@/config';\r\nexport default {\r\n  data() {\r\n    return {\r\n      blogs: []\r\n    }\r\n  },\r\n  async created() {\r\n    try {\r\n\r\n      const response = await axios.get(`${API_LOCATION}/blog`);\r\n      console.log(response.data)\r\n      this.blogs = response.data.blog\r\n      console.log(this.blogs)\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n  },\r\n};\r\n</script>\r\n"]},"metadata":{},"sourceType":"module","externalDependencies":[]}