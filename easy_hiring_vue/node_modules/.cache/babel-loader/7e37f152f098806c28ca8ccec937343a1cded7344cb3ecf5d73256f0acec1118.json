{"ast":null,"code":"import axios from 'axios';\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  data() {\n    return {\n      jobs: []\n    };\n  },\n  async created() {\n    try {\n      const response = await axios.get(`${API_LOCATION}/waitingList`);\n      console.log(response.data);\n      this.jobs = response.data.users;\n    } catch (error) {\n      console.log(error);\n    }\n  },\n  methods: {\n    async acceptUser(jobId) {\n      try {\n        const respo = await axios.post(`${API_LOCATION}/waitingList/${jobId}`);\n        console.log(respo);\n        // remove the city from the data array\n        this.jobs = this.jobs.filter(item => item.id !== jobId);\n      } catch (error) {\n        console.log(error);\n      }\n    },\n    async\n  }\n};","map":{"version":3,"mappings":"AAuEA;AACA;AACA;EACAA;IACA;MACAC;IACA;EACA;EACA;IACA;MAGA;MACAC;MACA;IACA;MACAA;IACA;EACA;EACAC;IACA;MACA;QACA;QACAD;QACA;QACA;MAEA;QACAA;MACA;IACA;IACAE;EAEA;AACA","names":["data","jobs","console","methods","async"],"sourceRoot":"src/components/admin","sources":["Admin-WaitingList.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <v-card class=\"ma-10\">\r\n            <div class=\"pa-3\">\r\n                <p class=\"text-h6 indigo--text mb-0 pb-0\">Waiting User List</p>\r\n                <span class=\"caption\">Below you can see all waiting user</span>\r\n            </div>\r\n\r\n            <v-simple-table>\r\n                <template v-slot:default>\r\n                    <thead>\r\n                        <tr>\r\n                            <th class=\"text-left\">\r\n                                Username\r\n                            </th>\r\n                            <th class=\"text-left\">\r\n                                Email\r\n                            </th>\r\n                            <th class=\"text-left\">\r\n                                Citizenship\r\n                            </th>\r\n\r\n                            <th class=\"text-left\">\r\n                                Location\r\n                            </th>\r\n                            <th class=\"text-left\">\r\n                                Action\r\n                            </th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                        <tr v-for=\"item in jobs\" :key=\"item.id\">\r\n                            <td>{{ item.name }}</td>\r\n                            <td>{{ item.email }}</td>\r\n                            <td class=\"p-3\">\r\n                                <!-- <v-img class=\"white--text align-end\" height=\"100px\" :src=\"item.citizenShip\"\r\n                                    :style=\"{ objectFit: 'cover', width: '300px' }\">\r\n                                </v-img> -->\r\n\r\n                                <img :src=\"item.citizenShip\" height=\"100px\" :style=\"{ objectFit: 'cover', width: '300px' }\">\r\n\r\n\r\n\r\n                                {{ item.citizenShip }}\r\n                                \r\n                                <a :href=\"'http://localhost:3000/1706239137057-systemarch.drawio.png'\">View Citizenship</a>  \r\n                                <!-- <a :href=\"item.citizenShip\">View Citizenship</a>   -->\r\n\r\n                                <button onclick=\"goToImage(item.citizenShip)\">111</button>\r\n        \r\n                            </td>\r\n                            \r\n                            <td>{{ item.location }}</td>\r\n\r\n                            <td>\r\n                                <v-btn small class=\"ma-2\" @click=\"acceptUser(item.id)\">\r\n                                    <v-icon small color=\"green\">mdi-check</v-icon>\r\n                                </v-btn>\r\n                                <!-- <v-btn small class=\"ma-2\">\r\n                                    <v-icon small color=\"primary\">mdi-eye</v-icon>\r\n                                </v-btn> -->\r\n\r\n                            </td>\r\n                        </tr>\r\n                    </tbody>\r\n                </template>\r\n            </v-simple-table>\r\n        </v-card>\r\n    </div>\r\n</template>\r\n<script>\r\nimport axios from 'axios';\r\nimport { API_LOCATION } from \"../../config/index\";\r\nexport default {\r\n    data() {\r\n        return {\r\n            jobs: []\r\n        }\r\n    },\r\n    async created() {\r\n        try {\r\n\r\n\r\n            const response = await axios.get(`${API_LOCATION}/waitingList`);\r\n            console.log(response.data)\r\n            this.jobs = response.data.users;\r\n        } catch (error) {\r\n            console.log(error)\r\n        }\r\n    },\r\n    methods: {\r\n        async acceptUser(jobId) {\r\n            try {\r\n                const respo = await axios.post(`${API_LOCATION}/waitingList/${jobId}`);\r\n                console.log(respo)\r\n                // remove the city from the data array\r\n                this.jobs = this.jobs.filter(item => item.id !== jobId);\r\n\r\n            } catch (error) {\r\n                console.log(error);\r\n            }\r\n        },\r\n        async \r\n        \r\n    }\r\n}\r\n</script>\r\n  \r\n  "]},"metadata":{},"sourceType":"module","externalDependencies":[]}