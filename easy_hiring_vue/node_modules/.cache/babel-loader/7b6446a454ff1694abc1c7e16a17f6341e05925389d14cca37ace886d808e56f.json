{"ast":null,"code":"import axios from \"axios\";\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  data: () => ({\n    name: \"\",\n    email: \"\",\n    password: \"\",\n    image: null,\n    rules: {\n      required: value => !!value || \"Required.\",\n      min: v => v.length >= 8 || \"Min 8 characters\",\n      emailMatch: () => `The email and password you entered don't match`\n    }\n  }),\n  async created() {\n    try {\n      const response2 = await axios.get(`${API_LOCATION}/getMe`);\n      console.log(response2.data.user);\n      this.name = response2.data.user.name;\n      this.email = response2.data.user.email;\n      this.image = response2.data.user.image;\n      // this.name = response2.data.user.name;\n      console.log(this.jobs);\n    } catch (error) {\n      console.log(error);\n    }\n  },\n  methods: {\n    async submitForm() {\n      let formData = new FormData();\n      formData.append('name', this.name);\n      formData.append('image', this.image);\n      formData.append('email', this.email);\n      formData.append('password', this.password);\n      const response = await axios.patch(`${API_LOCATION}/updatePassword`, formData, {\n        headers: {\n          'Content-Type': 'multipart/form-data'\n        }\n      });\n      location.reload();\n      console.log(response.data);\n    }\n  }\n};","map":{"version":3,"mappings":"AAwCA;AACA;AACA;EACAA;IACAC;IACAC;IACAC;IACAC;IACAC;MACAC;MACAC;MACAC;IACA;EACA;EACA;IACA;MAGA;MACAC;MACA;MACA;MACA;MACA;MACAA;IACA;MACAA;IACA;EACA;EACAC;IACA;MACA;MACAC;MACAA;MACAA;MACAA;MAEA;QACAC;UACA;QACA;MACA;MACAC;MACAJ;IAEA;EACA;AACA","names":["data","name","email","password","image","rules","required","min","emailMatch","console","methods","formData","headers","location"],"sourceRoot":"src/components/user","sources":["Update-User-Profile.vue"],"sourcesContent":["<template>\r\n  <div class=\"pa-6\">\r\n    <v-row class=\"justify-center\">\r\n      <v-col md=\"5\">\r\n        <v-card class=\"pa-6\">\r\n          <v-banner>\r\n            <div class=\"pa-3 text-center\">\r\n              <img :src=\"image\" width=\"70\" alt=\"\">\r\n              <p class=\"text-h6 indigo--text mb-0 pb-0\">Hello! Mr. {{ name }}</p>\r\n              <span class=\"caption\">{{ email }}</span>\r\n            </div>\r\n          </v-banner>\r\n          <div>\r\n            <p class=\"caption\">Name</p>\r\n            <v-text-field v-model=\"name\" solo label=\"Solo\" clearable></v-text-field>\r\n          </div>\r\n          <div>\r\n            <p class=\"caption\">Email</p>\r\n            <v-text-field v-model=\"email\" solo label=\"Solo\" clearable disabled></v-text-field>\r\n          </div>\r\n          <div>\r\n            <p class=\"caption\">Update Password</p>\r\n            <v-text-field v-model=\"password\" :rules=\"[rules.required, rules.min]\" solo label=\"Change Password\" clearable></v-text-field>\r\n          </div>\r\n          <div>\r\n            <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n              <v-file-input v-model=\"image\" solo label=\"Upload Image Image\" chips required\r\n                truncate-length=\"7\"></v-file-input>\r\n            </v-col>\r\n          </div>\r\n          <div class=\"text-center\">\r\n            <v-btn small color=\"black\" class=\"white--text\" type=\"submit\" @click=\"submitForm\"> Update Profile </v-btn>\r\n          </div>\r\n        </v-card>\r\n      </v-col>\r\n    </v-row>\r\n  </div>\r\n</template>\r\n  \r\n<script>\r\nimport axios from \"axios\";\r\nimport { API_LOCATION } from \"../../config/index\";\r\nexport default {\r\n  data: () => ({\r\n    name: \"\",\r\n    email: \"\",\r\n    password: \"\",\r\n    image: null,\r\n    rules: {\r\n      required: (value) => !!value || \"Required.\",\r\n      min: (v) => v.length >= 8 || \"Min 8 characters\",\r\n      emailMatch: () => `The email and password you entered don't match`,\r\n    },\r\n  }),\r\n  async created() {\r\n    try {\r\n\r\n\r\n      const response2 = await axios.get(`${API_LOCATION}/getMe`);\r\n      console.log(response2.data.user)\r\n      this.name = response2.data.user.name;\r\n      this.email = response2.data.user.email;\r\n      this.image = response2.data.user.image;\r\n      // this.name = response2.data.user.name;\r\n      console.log(this.jobs)\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n  },\r\n  methods: {\r\n    async submitForm() {\r\n      let formData = new FormData()\r\n      formData.append('name', this.name)\r\n      formData.append('image', this.image)\r\n      formData.append('email', this.email)\r\n      formData.append('password', this.password)\r\n\r\n      const response = await axios.patch(`${API_LOCATION}/updatePassword`, formData, {\r\n        headers: {\r\n          'Content-Type': 'multipart/form-data'\r\n        }\r\n      });\r\n      location.reload()\r\n      console.log(response.data)\r\n\r\n    }\r\n  }\r\n};\r\n</script>\r\n  "]},"metadata":{},"sourceType":"module","externalDependencies":[]}