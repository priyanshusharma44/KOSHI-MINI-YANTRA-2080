{"ast":null,"code":"import TemplateView from './Template-View.vue';\nimport axios from \"axios\";\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  components: {\n    TemplateView\n  },\n  data() {\n    return {\n      name: '',\n      email: '',\n      subject: '',\n      message: ''\n    };\n  },\n  methods: {\n    async sendMessage() {\n      axios.post(API_LOCATION + '/contact/add-contact', {\n        name: this.name,\n        email: this.email,\n        subject: this.subject,\n        message: this.message\n      }).then(response => {\n        console.log(response.data);\n      }).catch(error => {\n        console.log(error);\n      });\n    }\n  }\n};","map":{"version":3,"mappings":"AAgGA;AAEA;AACA;AAEA;EACAA;IAAAC;EAAA;EAEAC;IACA;MACAC;MACAC;MACAC;MACAC;IACA;EACA;EACAC;IACA;MACAC;QACAL;QACAC;QACAC;QACAC;MACA;QACAG;MACA;QACAA;MACA;IACA;EACA;AACA","names":["components","TemplateView","data","name","email","subject","message","methods","axios","console"],"sourceRoot":"src/components/user","sources":["Home-View.vue"],"sourcesContent":["<template>\r\n    <template-view>\r\n        <!-- Section 1 -->\r\n        <section class=\"hero\" id=\"home\" style=\"display: flex;\">\r\n            <div class=\"w-50\" style=\"margin-left: -26rem ;\">\r\n                <h1 style=\"color :#3f51b5 \">\"Lorem ipsum dolor sit amet consectetur adipisicing elit. Quod necessitatibus\r\n                    voluptatem\".\r\n                </h1>\r\n                <!-- <button class=\"btn btn-warning\" style=\"background-color:#4CAF50 !important\">Learn More</button> -->\r\n            </div>\r\n            <div style=\"margin-top: -20rem;border: 1px solid red;\">\r\n                <!-- <div style=\"display: flex;flex-direction: column;\">\r\n              <h1>for Clients</h1>\r\n              <div>\r\n                  <button>hello</button>\r\n                  <button>hello</button>\r\n                  <button>hello</button>\r\n              </div>\r\n    