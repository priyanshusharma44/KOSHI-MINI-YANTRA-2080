rd-title>\r\n          </v-img>\r\n\r\n          <v-card-subtitle class=\"pb-0\"> {{ blog.date }} </v-card-subtitle>\r\n\r\n          <v-card-text class=\"text--primary\">\r\n\r\n\r\n            <div>{{ blog.description }}</div>\r\n          </v-card-text>\r\n\r\n          <v-card-actions>\r\n            <!-- <v-btn color=\"orange\" text> Share </v-btn> -->\r\n\r\n            <v-btn color=\"orange\" text @click=\"$router.push(`/single-blog/${blog.id}`)\"> Explore </v-btn>\r\n          </v-card-actions>\r\n        </v-card>\r\n\r\n      </v-col>\r\n    </v-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport { API_LOCATION } from '@/config';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      blogs: []\r\n    }\r\n  },\r\n  async created() {\r\n    try {\r\n\r\n      const response = await axios.get(`${API_LOCATION}/blog`);\r\n      console.log(response.data)\r\n      this.blogs = response.data.blog\r\n      console.log(this.blogs)\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n  },\r\n  methods: {\r\n    alarm() {\r\n      alert(\"Turning on alarm...\");\r\n    },\r\n    blinds() {\r\n      alert(\"Toggling Blinds...\");\r\n    },\r\n    lights() {\r\n      alert(\"Toggling lights...\");\r\n    },\r\n  },\r\n};\r\n</script>\r\n"]},"metadata":{},"sourceType":"module","externalDependencies":[]}