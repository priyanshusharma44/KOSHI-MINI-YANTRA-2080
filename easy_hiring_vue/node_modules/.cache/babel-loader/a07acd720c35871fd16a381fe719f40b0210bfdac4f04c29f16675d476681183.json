{"ast":null,"code":"import \"quill/dist/quill.core.css\";\nimport \"quill/dist/quill.snow.css\";\nimport \"quill/dist/quill.bubble.css\";\nimport { quillEditor } from \"vue-quill-editor\";\nimport axios from \"axios\";\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  components: {\n    quillEditor\n  },\n  data: () => ({\n    items: [],\n    blogs: [],\n    title: \"\",\n    description: \"\",\n    category: \"\",\n    image: \"\",\n    date: \"\",\n    valid: true,\n    name: \"\",\n    nameRules: [v => !!v || \"Name is required\", v => v && v.length <= 10 || \"Name must be less than 10 characters\"],\n    email: \"\",\n    emailRules: [v => !!v || \"E-mail is required\", v => /.+@.+\\..+/.test(v) || \"E-mail must be valid\"],\n    show1: false,\n    password: \"\",\n    rules: {\n      required: value => !!value || \"Required.\",\n      min: v => v.length >= 8 || \"Min 8 characters\",\n      emailMatch: () => `The email and password you entered don't match`\n    },\n    checkbox: false\n  }),\n  async created() {\n    try {\n      console;\n      if (this.$route.params.id) {\n        this.blogId = this.$route.params.id;\n        // If an ID is present, fetch the existing blog post data\n        const res = await axios.get(`${API_LOCATION}/blog/edit/${this.blogId}`);\n        const existingBlog = res.data.blog;\n\n        // Set the form fields with the existing data\n        this.title = existingBlog.title;\n        this.description = existingBlog.description;\n        this.category = existingBlog.category;\n        this.image = existingBlog.image;\n        this.date = existingBlog.date;\n        // ... set other fields accordingly\n      }\n\n      const response = await axios.get(`${API_LOCATION}/get-all-category`);\n      this.items = response.data.category;\n    } catch (error) {\n      console.log(error);\n    }\n  },\n  methods: {\n    validate() {\n      this.$refs.form.validate();\n    },\n    reset() {\n      this.$refs.form.reset();\n    },\n    resetValidation() {\n      this.$refs.form.resetValidation();\n    },\n    async submitForm() {\n      let formData = new FormData();\n      formData.append('title', this.title);\n      formData.append('content', this.content);\n      formData.append('image', this.image);\n      formData.append('description', this.description);\n      formData.append('category', this.category);\n      formData.append('date', this.date);\n      try {\n        const response = await axios.post(`${API_LOCATION}/blog`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        this.data = response.data.job;\n        alert('Blog Added Sucessfully !!');\n      } catch (error) {\n        console.log(error);\n      }\n    }\n  }\n};","map":{"version":3,"mappings":"AAoEA;AACA;AACA;AAEA;AACA;AACA;AAGA;EACAA;IACAC;EACA;EACAC;IACAC;IACAC;IACAC;IACAC;IACAC;IACAC;IACAC;IAEAC;IAEAC;IACAC,YACAC,gCACAA,mEACA;IACAC;IACAC,aACAF,kCACAA,mDACA;IACAG;IAEAC;IACAC;MACAC;MACAC;MACAC;IACA;IACAC;EACA;EACA;IACA;MAEAC;MACA;QACA;QACA;QACA;QACA;;QAEA;QACA;QACA;QACA;QACA;QACA;QACA;MACA;;MAGA;MAEA;IAEA;MACAA;IACA;EAEA;EACAC;IACAC;MACA;IACA;IACAC;MACA;IACA;IACAC;MACA;IACA;IACA;MACA;MACAC;MACAA;MAEAA;MACAA;MACAA;MACAA;MACA;QAEA;UACAC;YACA;UACA;QACA,EACA;QAEA;QACAC;MAEA;QACAP;MACA;IACA;EACA;AACA","names":["components","quillEditor","data","items","blogs","title","description","category","image","date","valid","name","nameRules","v","email","emailRules","show1","password","rules","required","min","emailMatch","checkbox","console","methods","validate","reset","resetValidation","formData","headers","alert"],"sourceRoot":"src/components/admin","sources":["Admin-BlogEdit.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-row>\r\n      <v-col md=\"12\">\r\n        <div>\r\n          <v-banner class=\"ma-3\">\r\n            <p class=\"text-h5 indigo--text mb-0\">Write your Inside Story</p>\r\n            <span class=\"caption\">Please fill up the below form to post a Blog</span>\r\n          </v-banner>\r\n          <v-form class=\"pa-5 ma-10\" ref=\"form\" v-model=\"valid\" lazy-validation @submit.prevent=\"submitForm\">\r\n            <v-text-field v-model=\"title\"  label=\"Title\" required></v-text-field>\r\n\r\n            <quill-editor v-model=\"content\" ref=\"myQuillEditor\" :options=\"editorOption\" @blur=\"onEditorBlur($event)\"\r\n              @focus=\"onEditorFocus($event)\" @ready=\"onEditorReady($event)\">\r\n            </quill-editor>\r\n\r\n            <v-text-field v-model=\"description\" label=\"description\" required></v-text-field>\r\n\r\n            <v-row>\r\n              <v-col cols=\"16\" sm=\"6\" md=\"4\">\r\n                <v-menu ref=\"menu\" v-model=\"menu\" :close-on-content-click=\"false\" :return-value.sync=\"date\"\r\n                  transition=\"scale-transition\" offset-y min-width=\"auto\">\r\n                  <template v-slot:activator=\"{ on, attrs }\">\r\n                    <v-text-field v-model=\"date\" label=\"Picker in menu\" prepend-icon=\"mdi-calendar\" readonly\r\n                      v-bind=\"attrs\" v-on=\"on\"></v-text-field>\r\n                  </template>\r\n                  <v-date-picker v-model=\"date\" no-title scrollable>\r\n                    <v-spacer></v-spacer>\r\n                    <v-btn text color=\"primary\" @click=\"menu = false\">\r\n                      Cancel\r\n                    </v-btn>\r\n                    <v-btn text color=\"primary\" @click=\"$refs.menu.save(date)\">\r\n                      OK\r\n                    </v-btn>\r\n                  </v-date-picker>\r\n                </v-menu>\r\n              </v-col>\r\n\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n                <v-file-input v-model=\"image\" label=\"Upload Image\" chips truncate-length=\"7\"></v-file-input>\r\n              </v-col>\r\n              <v-col cols=\"12\" sm=\"6\" md=\"4\">\r\n\r\n                <v-div>\r\n\r\n                  <v-select v-model=\"category\" :items=\"items\" item-text=\"name\" item-value=\"id\"\r\n                    label=\"Select a category\"></v-select>\r\n                </v-div>\r\n\r\n              </v-col>\r\n            </v-row>\r\n\r\n\r\n            <v-row>\r\n              <v-col>\r\n                <v-btn :disabled=\"!valid\" color=\"indigo\" small class=\"mr-4 white--text\" type=\"submit\" @click=\"validate\">\r\n                  Post Blog\r\n                </v-btn>\r\n              </v-col>\r\n            </v-row>\r\n          </v-form>\r\n        </div>\r\n      </v-col>\r\n    </v-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport \"quill/dist/quill.core.css\";\r\nimport \"quill/dist/quill.snow.css\";\r\nimport \"quill/dist/quill.bubble.css\";\r\n\r\nimport { quillEditor } from \"vue-quill-editor\";\r\nimport axios from \"axios\";\r\nimport { API_LOCATION } from \"../../config/index\";\r\n\r\n\r\nexport default {\r\n  components: {\r\n    quillEditor,\r\n  },\r\n  data: () => ({\r\n    items: [],\r\n    blogs : [],\r\n    title: \"\",\r\n    description: \"\",\r\n    category: \"\",\r\n    image: \"\",\r\n    date: \"\",\r\n\r\n    valid: true,\r\n\r\n    name: \"\",\r\n    nameRules: [\r\n      (v) => !!v || \"Name is required\",\r\n      (v) => (v && v.length <= 10) || \"Name must be less than 10 characters\",\r\n    ],\r\n    email: \"\",\r\n    emailRules: [\r\n      (v) => !!v || \"E-mail is required\",\r\n      (v) => /.+@.+\\..+/.test(v) || \"E-mail must be valid\",\r\n    ],\r\n    show1: false,\r\n\r\n    password: \"\",\r\n    rules: {\r\n      required: (value) => !!value || \"Required.\",\r\n      min: (v) => v.length >= 8 || \"Min 8 characters\",\r\n      emailMatch: () => `The email and password you entered don't match`,\r\n    },\r\n    checkbox: false,\r\n  }),\r\n  async created() {\r\n    try {\r\n\r\nconsole\r\n      if (this.$route.params.id) {\r\n        this.blogId = this.$route.params.id;\r\n        // If an ID is present, fetch the existing blog post data\r\n        const res = await axios.get(`${API_LOCATION}/blog/edit/${this.blogId}`);\r\n        const existingBlog = res.data.blog;\r\n\r\n        // Set the form fields with the existing data\r\n        this.title = existingBlog.title;\r\n        this.description = existingBlog.description;\r\n        this.category = existingBlog.category;\r\n        this.image = existingBlog.image;\r\n        this.date = existingBlog.date;\r\n        // ... set other fields accordingly\r\n      }\r\n\r\n\r\n      const response = await axios.get(`${API_LOCATION}/get-all-category`);\r\n\r\n      this.items = response.data.category;\r\n\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n\r\n  },\r\n  methods: {\r\n    validate() {\r\n      this.$refs.form.validate();\r\n    },\r\n    reset() {\r\n      this.$refs.form.reset();\r\n    },\r\n    resetValidation() {\r\n      this.$refs.form.resetValidation();\r\n    },\r\n    async submitForm() {\r\n      let formData = new FormData()\r\n      formData.append('title', this.title)\r\n      formData.append('content', this.content)\r\n\r\n      formData.append('image', this.image)\r\n      formData.append('description', this.description)\r\n      formData.append('category', this.category)\r\n      formData.append('date', this.date)\r\n      try {\r\n\r\n        const response = await axios.post(`${API_LOCATION}/blog`, formData, {\r\n          headers: {\r\n            'Content-Type': 'multipart/form-data'\r\n          }\r\n        }\r\n        )\r\n        \r\n        this.data = response.data.job\r\n        alert('Blog Added Sucessfully !!')\r\n\r\n      } catch (error) {\r\n        console.log(error)\r\n      }\r\n    }\r\n  },\r\n};\r\n</script>\r\n"]},"metadata":{},"sourceType":"module","externalDependencies":[]}