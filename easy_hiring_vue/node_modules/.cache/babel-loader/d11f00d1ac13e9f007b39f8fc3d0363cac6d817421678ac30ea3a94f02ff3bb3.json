{"ast":null,"code":"import axios from 'axios';\nimport { API_LOCATION } from \"../../config/index\";\nexport default {\n  data() {\n    return {\n      data: null,\n      showCityModal: false,\n      name: \"\",\n      image: \"\"\n    };\n  },\n  async created() {\n    try {\n      const response = await axios.get(`${API_LOCATION}/city`);\n      console.log(response.data);\n      this.data = response.data.city;\n      // console.log(this.data)\n    } catch (error) {\n      console.log(error);\n    }\n  },\n  methods: {\n    async deleteCity(cityId) {\n      try {\n        await axios.delete(`${API_LOCATION}/city/${cityId}`);\n        // remove the city from the data array\n        this.data = this.data.filter(item => item.id !== cityId);\n      } catch (error) {\n        console.log(error);\n      }\n    },\n    async showCityDetails(cityId) {\n      try {\n        const response = await axios.get(`${API_LOCATION}/city/${cityId}`);\n        this.name = response.data.city.name;\n        this.image = response.data.city.image;\n        console.log(this.name);\n        this.showCityModal = true;\n      } catch (error) {\n        console.log(error);\n      }\n    }\n  }\n};","map":{"version":3,"mappings":"AA8DA;AACA;AACA;EACAA;IACA;MACAA;MACAC;MACAC;MACAC;IAEA;EACA;EACA;IACA;MAEA;MACAC;MACA;MACA;IACA;MACAA;IACA;EAEA;EACAC;IACA;MACA;QACA;QACA;QACA;MACA;QACAD;MACA;IACA;IACA;MACA;QACA;QACA;QACA;QACAA;QACA;MACA;QACAA;MACA;IACA;EACA;AACA","names":["data","showCityModal","name","image","console","methods"],"sourceRoot":"src/components/admin","sources":["Admin-Citylist.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <v-card class=\"ma-10\">\r\n      <div class=\"pa-3\">\r\n        <p class=\"text-h6 indigo--text mb-0 pb-0\">City List</p>\r\n        <span class=\"caption\">Below you can see all Posted Citys</span>\r\n      </div>\r\n\r\n      <div class=\"d-flex justify-end mr-10\">\r\n        <v-btn color=\"blue\" @click=\"$router.push('/admin-city')\">Add City</v-btn>\r\n      </div>\r\n      <v-simple-table>\r\n        <template v-slot:default>\r\n          <thead>\r\n            <tr>\r\n              <th class=\"text-left\">\r\n                Name\r\n              </th>\r\n              <th class=\"text-left\">\r\n                Action\r\n              </th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"item in data\" :key=\"item.id\">\r\n\r\n\r\n\r\n              <td> <v-list-item-avatar>\r\n                  <v-img :src=\"item.image\">\r\n                  </v-img>\r\n                </v-list-item-avatar>{{ item.name }}</td>\r\n\r\n              <td>\r\n\r\n                <v-btn small class=\"ma-2\" @click=\"deleteCity(item.id)\">\r\n                  <v-icon small color=\"red\">mdi-cancel</v-icon>\r\n                </v-btn>\r\n                <v-btn small class=\"ma-2\" @click=\"showCityDetails(item.id)\">\r\n                  <v-icon small color=\"primary\">mdi-eye</v-icon>\r\n                </v-btn>\r\n\r\n              </td>\r\n            </tr>\r\n            <v-dialog v-model=\"showCityModal\" max-width=\"400px\" center>\r\n              <v-card>\r\n                <v-card-title class=\"headline\">{{ name }}</v-card-title>\r\n                <v-card-text>\r\n                  <img :src=\"image\" alt=\"\" srcset=\"\" style=\"width: 370px;\">\r\n                </v-card-text>\r\n                <v-card-actions>\r\n                  <v-btn color=\"indigo\" text @click=\"showCityModal = false\">Close</v-btn>\r\n                </v-card-actions>\r\n              </v-card>\r\n            </v-dialog>\r\n          </tbody>\r\n        </template>\r\n      </v-simple-table>\r\n    </v-card>\r\n  </div>\r\n</template>\r\n<script>\r\nimport axios from 'axios';\r\nimport { API_LOCATION } from \"../../config/index\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      data: null,\r\n      showCityModal: false,\r\n      name: \"\",\r\n      image: \"\"\r\n\r\n    }\r\n  },\r\n  async created() {\r\n    try {\r\n\r\n      const response = await axios.get(`${API_LOCATION}/city`);\r\n      console.log(response.data)\r\n      this.data = response.data.city;\r\n      // console.log(this.data)\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n\r\n  },\r\n  methods: {\r\n    async deleteCity(cityId) {\r\n      try {\r\n        await axios.delete(`${API_LOCATION}/city/${cityId}`);\r\n        // remove the city from the data array\r\n        this.data = this.data.filter(item => item.id !== cityId);\r\n      } catch (error) {\r\n        console.log(error);\r\n      }\r\n    },\r\n    async showCityDetails(cityId) {\r\n      try {\r\n        const response = await axios.get(`${API_LOCATION}/city/${cityId}`);\r\n        this.name = response.data.city.name;\r\n        this.image = response.data.city.image;\r\n        console.log(this.name)\r\n        this.showCityModal = true;\r\n      } catch (error) {\r\n        console.log(error);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n"]},"metadata":{},"sourceType":"module","externalDependencies":[]}